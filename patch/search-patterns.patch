+def _quote_search_pattern(pattern: str) -> str:
+    """Quote regex/glob data without Windows filesystem path normalization."""
+    # Adjacent quoted fragments keep Git Bash's Windows argv parser from
+    # collapsing pairs of backslashes before bash evaluates the command.
+    escaped = pattern.replace("'", "'\"'\"'").replace("\\", "\\''")
+    return "'" + escaped + "'"
+
 
